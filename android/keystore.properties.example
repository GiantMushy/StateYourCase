# Copy to keystore.properties (git-ignored, next to this file) and fill in your upload key.
# `npm run android:release` signs the Play bundle with it. Keep the .jks file and these
# passwords in a password manager: every update must be signed with the same key.
#
# storeFile: an absolute path, or relative to this android/ folder.
storeFile=/Users/YOU/Keys/state-your-case-upload.jks
storePassword=
keyAlias=upload
keyPassword=
